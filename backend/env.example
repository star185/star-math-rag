# ===== 大模型配置（复制为 backend/.env 或导出环境变量）=====
# 二选一：DeepSeek 或 智谱 / 通义 / 其它 OpenAI 兼容接口

# --- DeepSeek（推荐）---
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=sk-在这里粘贴你的密钥
LLM_MODEL=deepseek-chat

# --- 智谱 GLM（示例）---
# LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
# LLM_API_KEY=你的智谱密钥
# LLM_MODEL=glm-4-air

# --- 通义千问（DashScope 兼容模式，示例）---
# LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=sk-你的DashScope密钥
# LLM_MODEL=qwen-plus

# --- 可选：远程 Embedding（不填则用本地向量）---
# EMBED_API_BASE=https://api.openai.com/v1
# EMBED_API_KEY=sk-...
# EMBED_MODEL=text-embedding-3-small

# --- 生成参数 ---
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=60

# --- 检索参数 ---
TOP_K=5
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# --- 账号 ---
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=admin123
