# ===== 配置模板 =====
# 支持两个位置，优先级：进程环境变量 > 用户级密钥文件 > 项目内 backend/.env
#
# 1) 密钥放在项目目录之外（推荐：打包/分发源码时不会连带流出）
#      Windows : %APPDATA%\StarMath\.env
#      Linux/macOS: ~/.config/star-math/.env
#      自定义位置 : 设环境变量 STAR_MATH_ENV_FILE 指向任意 .env
#    该文件只需写下面「密钥」一节。
#
# 2) 只想本机快速试跑：复制本文件为 backend/.env，直接填写密钥也可（会生效）。
#
# 密钥留空时系统运行在本地抽取模式：问答、检索、习题册功能仍可完整演示，只是答案不经过大模型润色。

# ---------- 密钥（只写这几项）----------
# DeepSeek / 任意 OpenAI 兼容接口
LLM_API_KEY=sk-在这里粘贴你的密钥
# 习题图片识别的视觉模型（阿里云百炼 DashScope 等），留空则回退本地 OCR
VISION_LLM_API_KEY=

# ---------- 大模型 ----------
LLM_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# --- 智谱 GLM（示例）---
# LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-air
# --- 通义千问（DashScope 兼容模式，示例）---
# LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# --- 视觉模型（习题上传中的图片识别）---
VISION_LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_LLM_MODEL=qwen-vl-ocr

# --- 可选：远程 Embedding（不填则用本地字符 n-gram 向量）---
# EMBED_API_BASE=https://api.openai.com/v1
# EMBED_API_KEY=sk-...
# EMBED_MODEL=text-embedding-3-small

# --- 生成参数 ---
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=60

# --- 检索参数 ---
TOP_K=5
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# --- 账号与注册 ---
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=admin123
# 非空则注册必须填邀请码；也可在设置页生成一次性邀请码后清空此值
REGISTER_INVITE_CODE=
